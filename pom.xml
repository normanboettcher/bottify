<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      Spring Boot's starter parent gives us dependency + plugin management and the
      compiler configuration. The domain and application modules inherit this *build*
      configuration but deliberately declare no Spring dependencies (see ADR-0002,
      hexagonal core stays framework-agnostic).
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.8</version>
        <relativePath/>
    </parent>

    <groupId>de.bottify</groupId>
    <artifactId>bottify</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Bottify</name>
    <description>Private single-user CD streaming server</description>

    <!--
      Module layout follows Ports &amp; Adapters (hexagonal):
        core:      domain  ->  application (defines the ports)
        adapters:  rest (inbound) | persistence, filestore, transcoder (outbound)
        assembly:  bootstrap (composition root, the single deployable per ADR-0002)

      The four adapters depend only on 'application', never on each other, so the
      reactor builds them in parallel (great with mvnd). Only 'bootstrap' joins them.
    -->
    <modules>
        <module>bottify-domain</module>
        <module>bottify-application</module>
        <module>bottify-adapter-rest</module>
        <module>bottify-adapter-persistence</module>
        <module>bottify-adapter-filestore</module>
        <module>bottify-adapter-transcoder</module>
        <module>bottify-bootstrap</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Third-party libraries not managed by the Spring Boot BOM -->
        <jaudiotagger.version>3.0.1</jaudiotagger.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules: versioned once, referenced without a version elsewhere -->
            <dependency>
                <groupId>de.bottify</groupId>
                <artifactId>bottify-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.bottify</groupId>
                <artifactId>bottify-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.bottify</groupId>
                <artifactId>bottify-adapter-rest</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.bottify</groupId>
                <artifactId>bottify-adapter-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.bottify</groupId>
                <artifactId>bottify-adapter-filestore</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>de.bottify</groupId>
                <artifactId>bottify-adapter-transcoder</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Audio tag/cover-art reading (ADR-0004); not in the Spring Boot BOM -->
            <dependency>
                <groupId>net.jthink</groupId>
                <artifactId>jaudiotagger</artifactId>
                <version>${jaudiotagger.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
