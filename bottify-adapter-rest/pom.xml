<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.bottify</groupId>
        <artifactId>bottify</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>bottify-adapter-rest</artifactId>
    <name>Bottify :: Adapter :: REST</name>
    <description>
        Inbound (driving) adapter: the custom HTTP/JSON API the web player consumes
        (ADR-0003 — no Subsonic). Translates HTTP into calls on the application's inbound
        ports. Owns authentication (Spring Security) for the browser client.
        The SPA itself is a separate frontend served by Caddy (ADR-0007), not built here.
    </description>

    <dependencies>
        <dependency>
            <groupId>de.bottify</groupId>
            <artifactId>bottify-application</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
